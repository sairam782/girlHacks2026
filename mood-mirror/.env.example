# Copy to .env and fill in. Everything is optional: with no keys the app runs the demo offline.

# ElevenLabs: speaker-separated transcription (Scribe) + the spoken voice brief.
# If set, it is used for transcription instead of Azure Speech (override with TRANSCRIBER=azure).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2

# Azure OpenAI (emotion labels + personal suggestions)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Speech (alternative transcriber)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Or plain OpenAI instead of Azure OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
