# Copy to .env.local and fill in. Never commit .env.local.
# All optional. Without them Canopy falls back to built-in rules, the browser voice, and a local JSON store.
GEMINI_API_KEY=            # extraction + voice (GEMINI_MODEL defaults to gemini-3.5-flash-lite)
ELEVENLABS_API_KEY=        # morning briefing audio (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_VOICE_ID=       # optional: a voice from your Voice Library (defaults to "Rachel")
DATABASE_URL=              # Tiger Data (Timescale) connection string for the CommitmentEvent hypertable
CANOPY_DATABASE_URL=       # dedicated PostgreSQL store; takes precedence and disables legacy Tiger mirroring
# CANOPY_TODAY=2026-10-09  # pin "today" for demos
# CANOPY_TZ=America/New_York  # whose "today" leaves are measured against (servers run on UTC)
# CANOPY_DATA_DIR=/home/data  # where the JSON store and briefing audio live (Azure: /home persists)
# CANOPY_ALLOW_RESET=false     # turn off the "Reset demo data" button on a deployment with real data
CANOPY_DELETE_USERNAME=       # server-only credentials required for deleting projects
CANOPY_DELETE_PASSWORD=       # keep secret; configure in Vercel, never NEXT_PUBLIC_*
# CANOPY_STORE=postgres        # required storage mode on Vercel (automatic when VERCEL is set)
# CANOPY_STORE_KEY=canopy-girlhacks # independent application state row in PostgreSQL
# CANOPY_DEMO_MODE=true        # shared demo notice; initialize fictional data only for a new store

# --- Mood Mirror -------------------------------------------------------------
# The Python service in mood-mirror/. It handles recordings (speaker separation),
# the opt-in face layer, and the per-person spoken recap.
#   cd mood-mirror && pip install -r requirements.txt && uvicorn app:app --port 8000
# Transcripts and both demo meetings work without it.
MOOD_MIRROR_URL=http://127.0.0.1:8000

# Azure OpenAI labels each turn's tone and writes the suggestions. Without these,
# Mood Mirror falls back to an offline lexicon, which is enough for the demo.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Or plain OpenAI instead of Azure OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
